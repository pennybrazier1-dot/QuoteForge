# =============================================================================
# Reanvil environment variables
# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (public — safe in the browser; access is enforced by Row Level Security)
# From: Supabase project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Site URL (optional for Vercel previews — auto-detected from VERCEL_URL on deploy)
# Required for production. Production must be:
#   NEXT_PUBLIC_SITE_URL=https://reanvil.com
# Local dev default if unset: http://localhost:3000
# Also set this in Vercel → Project → Settings → Environment Variables (Production).
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://reanvil.com
#   Redirect URLs: https://reanvil.com/** and https://www.reanvil.com/**
#
# Supabase Dashboard → Authentication → Email Templates → Confirm signup:
#   Link must be:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup
#
# Password recovery emails redirect to:
#   https://reanvil.com/auth/reset-password
# (set via resetPasswordForEmail redirectTo; also allow that path under Redirect URLs)
#
# Auth verification emails are sent by Supabase Auth (or custom SMTP in the
# Supabase dashboard). RESEND_API_KEY below is ONLY for proposal emails — it
# does not send signup confirmation emails.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# Used to build absolute public enquiry links shown in Settings
# (/request-quote/w/[slug]). Local default if unset: http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (server-only — never expose to the client)
# Used for AI proposal generation
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Default: gpt-4o-mini
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Resend (server-only — never expose to the client)
# Used when sending proposal emails from the app
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Example: "Your Business Name <proposals@yourdomain.com>"
# If omitted, Resend sandbox sender is used when a business name is set
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Platform admin (server-only — temporary until role-based auth exists)
# Comma-separated login emails allowed to see /admin and the sidebar Admin link.
# These emails also skip trader onboarding: a workspace/profile is created
# automatically and they are sent to /admin after sign-in / email confirm.
# -----------------------------------------------------------------------------
PLATFORM_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Supabase service role (server-only — NEVER expose to the browser)
# Required for Phase 29 admin user deletion RPC (admin_delete_user).
# From: Supabase → Project Settings → API → service_role
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
